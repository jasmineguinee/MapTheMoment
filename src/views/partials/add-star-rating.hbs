
<script>
  let stars = 
    document.getElementsByClassName("star");

function getR(n) {
    remove();
    for (let i = 0; i < n && i < stars.length; i++) {
        stars[i].className = "star active";
    }

    
   document.getElementById("number").value = n;
}

function remove() {
    for (let i = 0; i < stars.length; i++){
      stars[i].className = "star"
    }
}
</script>

 <form class="box" action="/dashboard/{{venue._id}}/addrating/{{venue._id}}" method="POST">
        <label>Add a star rating</label>
        <br />
        <span onclick="getR(1)" class="star">★</span>
        <span onclick="getR(2)" class="star">★</span>
        <span onclick="getR(3)" class="star">★</span>
        <span onclick="getR(4)" class="star">★</span>
        <span onclick="getR(5)" class="star">★</span>
         <input hidden="hidden" id="number" name="number" value="">
  
      <button class="button is-info">Add Rating</button>
  </form>


    
