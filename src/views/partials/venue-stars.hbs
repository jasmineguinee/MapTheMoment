

 

    <div class="card">
       <label>Star Rating</label>
        <br />
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <p hidden= "hidden" id="avgrating">{{ avgrating }}</p>
        <p id="roundedAvg-text">{{ roundedAvg }}/5</p>
    </div>
  
 
 <script>
 document.addEventListener("DOMContentLoaded", function(){
    const displaystars = document.getElementsByClassName("displaystar");
   const avg = document.getElementById("avgrating").innerText;
 const avgRating = parseFloat(avg);
 if (isNaN(avgRating)){
  avgRating = 0;
 }

     for (let i = 0; i < displaystars.length; i++){
      displaystars[i].className = "displaystar";
    }

    for (let i = 0; i < avgRating && i < displaystars.length; i++) {
       if(i < Math.floor(avgRating)){
        displaystars[i].className = "displaystar active";
       }

       else if (i === Math.floor(avgRating) && avgRating % 1 !== 0) {
        displaystars[i].className = "displaystar half";
       }
       
       else {
        displaystars[i].className = "displaystar";
       }
    }
    
 });
 </script>
