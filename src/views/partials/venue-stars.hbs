 
 
 <script>
      let displaystars = 
    document.getElementsByClassName("displaystar");
document.addEventListener("DOMContentLoaded", function() {
   let avg = document.getElementById("avgrating").innerText;
 let avgRating = parseFloat(avg);
  showR(avgRating);

});



 let avg = document.getElementById("avgrating").innerText;
 let avgRating = parseFloat(avg);
  showR(avgRating);


 


function showR(avgRating) {

    remove();
    for (let i = 0; i < avgRating && i < displaystars.length; i++) {
       if(i < Math.floor(avgRating)){
        displaystars[i].className = "displaystar active";
       }

       else if (i === Math.floor(avgRating) && avgRating % 1 !== 0) {
        displaystars[i].className = "displaystar half";
       }
       
       else {
        displaystars[i].className = "displaystar";
       }
    }
    
}


function remove() {
    for (let i = 0; i < displaystars.length; i++){
      displaystars[i].className = "displaystar"
    }
   
}
 </script>

 

    <div class="card">
        <h1>Star Rating</h1>
        <br />
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
        <span class="displaystar">★</span>
      
        <p hidden= "hidden" id="avgrating" name="avgrating">{{ avgrating }}</p>
        <p id="avgrating" name="avgrating">{{ roundedAvg }}/5</p>
    </div>
  
  
