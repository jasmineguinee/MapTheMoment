{{> menu}}
{{> singleVenuePubMap}}

 
  <div class = "flex-container">
    {{#if venue.img}}
    <div>
     <figure>
       <img id = "dash-img" src="{{venue.img}}">
     </figure>
    </div>
    {{/if}}
   </div>
<h2 class="has-text-weight-medium is-size-4">{{venue.title}}</h2>
{{> venue-stars}}
{{> share-venue}}
{{> pubVenueDetails}}
{{> review-thread}}
{{> add-pubReview }}


{{!-- // The below function stops an option to add another rating if the user has already rated --}}
{{#unless myrating}}
 {{> add-star-rating}}
{{/unless}}

{{!-- myrating contains the users rating for the venue, as it is in a directory of ratings we reference each but they can only make one --}}
{{#if myrating}}
 {{#each myrating}}
 <div class="box box-link-hover-shadow">
  <p>You rated this venue as {{ number }}/5. Thank you for rating!</p>
  </div>
  {{/each}}
{{/if}}