{
  "name": "mapthemoment",
  "version": "1.0.0",
  "description": "Placemark Hapi/Node Application",
  "license": "ISC",
  "author": "Jasmine",
  "type": "module",
  "main": "src/server.js",

  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint . --ext .js",
    "test": "mocha --require ./src/server.js --ui tdd test/**/*.js --exit",
    "test:e2e": "playwright test ./test/e2e -- test",
    "coverage": "c8 mocha --require ./src/server.js ./src/server.js --ui tdd test/{models,api}/**/*.js --exit ",
    "dev": "nodemon  src/server.js --ignore src/models/json/*.json",
    "testmodels": "./node_modules/mocha/bin/mocha --require ./src/server.js --ui tdd test/models/**/*.js",
    "testapi": "./node_modules/mocha/bin/mocha --require ./src/server.js --ui tdd test/api/**/*.js"
  },
  "dependencies": {
    "@hapi/bell": "^13.1.0",
    "@hapi/boom": "^10.0.1",
    "@hapi/cookie": "^12.0.1",
    "@hapi/hapi": "^21.4.6",
    "@hapi/inert": "^7.1.0",
    "@hapi/vision": "^7.0.3",
    "argon2": "^0.44.0",
    "cloudinary": "^2.9.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.8",
    "hapi-auth-jwt2": "^11.0.0",
    "hapi-swagger": "^17.3.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lowdb": "^7.0.1",
    "mongoose": "^9.3.0",
    "sanitize-html": "^2.17.3",
    "uuid": "^13.0.0",
    "uuidv4": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.13.6",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=16"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**/*.js"
    ],
    "src": [
      "src"
    ]
  },
  "mocha": {
    "ignore": [
      "test/e2e/**/*"
    ]
  }
}
